{
  "name": "@haxbrasil/haxfootball-api-sdk",
  "version": "0.1.1",
  "description": "Fetch-based TypeScript SDK for the HaxFootball API.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/haxbrasil/haxfootball-api-sdk.git"
  },
  "packageManager": "pnpm@11.0.9",
  "sideEffects": false,
  "files": [
    "dist",
    "graphql",
    "openapi/haxfootball-api.yaml",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./openapi": {
      "default": "./openapi/haxfootball-api.yaml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm run generate:openapi && pnpm run generate:graphql",
    "generate:graphql": "graphql-codegen --config codegen.ts && prettier --write src/live/generated.ts",
    "generate:openapi": "openapi-typescript openapi/haxfootball-api.yaml -o src/generated/openapi.ts && prettier --write src/generated/openapi.ts",
    "prebuild": "pnpm run generate",
    "pretest": "pnpm run generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typed-document-node": "^7.0.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.5",
    "@types/node": "^24.10.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "tsdown": "^0.16.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.2"
  }
}
